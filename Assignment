<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Epson Home Cinema 5050UB - Premium 4K HDR Projector | TappAV</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #FF6B35;
            --primary-dark: #E85A28;
            --secondary: #004E89;
            --dark: #1A1A1D;
            --dark-lighter: #2C2C30;
            --light: #F7F7F7;
            --text-light: #A0A0A8;
            --success: #00D9A3;
            --spacing-xs: 0.5rem;
            --spacing-sm: 1rem;
            --spacing-md: 2rem;
            --spacing-lg: 4rem;
            --spacing-xl: 6rem;
            --border-radius: 8px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Outfit', sans-serif;
            background-color: var(--dark);
            color: var(--light);
            line-height: 1.6;
        }

        /* Header (same as homepage) */
        .header {
            position: fixed;
            top: 0;
            width: 100%;
            background: rgba(26, 26, 29, 0.95);
            backdrop-filter: blur(10px);
            z-index: 1000;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .header-top {
            background: linear-gradient(135deg, var(--secondary), #003566);
            padding: 0.5rem 0;
            font-size: 0.875rem;
            text-align: center;
            color: white;
        }

        .nav-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-family: 'Space Mono', monospace;
            font-size: 1.8rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: var(--primary);
            text-decoration: none;
        }

        .nav-menu {
            display: flex;
            list-style: none;
            gap: 2.5rem;
        }

        .nav-menu a {
            text-decoration: none;
            color: var(--light);
            font-weight: 500;
            transition: var(--transition);
        }

        .nav-menu a:hover {
            color: var(--primary);
        }

        .nav-actions {
            display: flex;
            gap: 1.5rem;
            align-items: center;
        }

        .search-icon, .cart-icon {
            cursor: pointer;
            font-size: 1.2rem;
            transition: var(--transition);
        }

        .search-icon:hover, .cart-icon:hover {
            color: var(--primary);
        }

        /* Breadcrumb */
        .breadcrumb {
            max-width: 1400px;
            margin: 120px auto 2rem;
            padding: 0 2rem;
            font-size: 0.875rem;
            color: var(--text-light);
        }

        .breadcrumb a {
            color: var(--text-light);
            text-decoration: none;
            transition: var(--transition);
        }

        .breadcrumb a:hover {
            color: var(--primary);
        }

        /* Product Section */
        .product-section {
            max-width: 1400px;
            margin: 0 auto 4rem;
            padding: 0 2rem;
        }

        .product-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4rem;
            margin-bottom: 4rem;
        }

        /* Image Gallery */
        .product-gallery {
            position: sticky;
            top: 120px;
            height: fit-content;
        }

        .main-image {
            background: var(--dark-lighter);
            border-radius: var(--border-radius);
            padding: 3rem;
            margin-bottom: 1rem;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 500px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .main-image img {
            max-width: 100%;
            max-height: 500px;
            object-fit: contain;
        }

        .thumbnail-gallery {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 1rem;
        }

        .thumbnail {
            background: var(--dark-lighter);
            border-radius: var(--border-radius);
            padding: 1rem;
            cursor: pointer;
            border: 2px solid transparent;
            transition: var(--transition);
            aspect-ratio: 1;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .thumbnail:hover, .thumbnail.active {
            border-color: var(--primary);
        }

        .thumbnail img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        /* Product Details */
        .product-details {
            animation: fadeIn 0.6s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .product-badge-group {
            display: flex;
            gap: 0.75rem;
            margin-bottom: 1.5rem;
        }

        .badge {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
        }

        .badge-new {
            background: var(--primary);
            color: white;
        }

        .badge-stock {
            background: var(--success);
            color: var(--dark);
        }

        .product-brand {
            color: var(--text-light);
            font-size: 1rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 0.5rem;
        }

        .product-title {
            font-size: 2.5rem;
            margin-bottom: 1rem;
            font-weight: 700;
            line-height: 1.2;
        }

        .product-rating {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .stars {
            color: #FFD700;
            font-size: 1.2rem;
        }

        .review-count {
            color: var(--text-light);
        }

        .product-price-section {
            background: var(--dark-lighter);
            padding: 2rem;
            border-radius: var(--border-radius);
            margin-bottom: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .price-main {
            font-size: 2.5rem;
            color: var(--primary);
            font-weight: 700;
            margin-bottom: 0.5rem;
        }

        .price-original {
            text-decoration: line-through;
            color: var(--text-light);
            font-size: 1.25rem;
            margin-right: 1rem;
        }

        .price-save {
            background: var(--success);
            color: var(--dark);
            padding: 0.25rem 0.75rem;
            border-radius: 4px;
            font-weight: 600;
            font-size: 0.875rem;
        }

        .emi-info {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            color: var(--text-light);
            font-size: 0.95rem;
        }

        .product-description {
            margin-bottom: 2rem;
            color: var(--text-light);
            font-size: 1.05rem;
            line-height: 1.8;
        }

        .key-features {
            background: var(--dark-lighter);
            padding: 2rem;
            border-radius: var(--border-radius);
            margin-bottom: 2rem;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .key-features h3 {
            font-size: 1.25rem;
            margin-bottom: 1.5rem;
            color: var(--primary);
        }

        .feature-list {
            display: grid;
            gap: 1rem;
        }

        .feature-item {
            display: flex;
            align-items: flex-start;
            gap: 1rem;
        }

        .feature-icon {
            font-size: 1.5rem;
            flex-shrink: 0;
        }

        .feature-text {
            color: var(--text-light);
        }

        .feature-text strong {
            color: var(--light);
            display: block;
            margin-bottom: 0.25rem;
        }

        /* Purchase Section */
        .purchase-section {
            position: sticky;
            top: 120px;
            background: var(--dark-lighter);
            padding: 2rem;
            border-radius: var(--border-radius);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .variant-selector {
            margin-bottom: 2rem;
        }

        .variant-selector h4 {
            margin-bottom: 1rem;
            font-size: 1rem;
        }

        .variant-options {
            display: grid;
            gap: 0.75rem;
        }

        .variant-option {
            padding: 1rem;
            border: 2px solid rgba(255, 255, 255, 0.1);
            border-radius: var(--border-radius);
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .variant-option:hover, .variant-option.active {
            border-color: var(--primary);
            background: rgba(255, 107, 53, 0.05);
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .quantity-selector h4 {
            font-size: 1rem;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .qty-btn {
            width: 40px;
            height: 40px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: var(--dark);
            color: var(--light);
            border-radius: 4px;
            cursor: pointer;
            font-size: 1.25rem;
            transition: var(--transition);
        }

        .qty-btn:hover {
            background: var(--primary);
            border-color: var(--primary);
        }

        .qty-input {
            width: 60px;
            height: 40px;
            text-align: center;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: var(--dark);
            color: var(--light);
            border-radius: 4px;
            font-size: 1rem;
        }

        .btn {
            padding: 1rem 2rem;
            border-radius: var(--border-radius);
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            border: none;
            font-size: 1rem;
            transition: var(--transition);
            display: block;
            text-align: center;
            width: 100%;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            box-shadow: 0 10px 30px rgba(255, 107, 53, 0.3);
            margin-bottom: 1rem;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(255, 107, 53, 0.4);
        }

        .btn-secondary {
            background: transparent;
            color: var(--light);
            border: 2px solid var(--light);
            margin-bottom: 2rem;
        }

        .btn-secondary:hover {
            background: var(--light);
            color: var(--dark);
        }

        .trust-badges {
            display: grid;
            gap: 1rem;
            padding-top: 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .trust-badge {
            display: flex;
            align-items: center;
            gap: 1rem;
            font-size: 0.9rem;
        }

        .trust-badge-icon {
            font-size: 1.5rem;
            color: var(--success);
        }

        /* Specifications */
        .specifications {
            margin-top: 4rem;
            background: var(--dark-lighter);
            padding: 3rem;
            border-radius: var(--border-radius);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .spec-tabs {
            display: flex;
            gap: 2rem;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            margin-bottom: 2rem;
        }

        .spec-tab {
            padding: 1rem 0;
            cursor: pointer;
            font-weight: 600;
            color: var(--text-light);
            transition: var(--transition);
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
        }

        .spec-tab:hover, .spec-tab.active {
            color: var(--primary);
            border-color: var(--primary);
        }

        .spec-content {
            display: none;
        }

        .spec-content.active {
            display: block;
            animation: fadeIn 0.4s ease-out;
        }

        .spec-grid {
            display: grid;
            gap: 1.5rem;
        }

        .spec-row {
            display: grid;
            grid-template-columns: 1fr 2fr;
            padding: 1rem 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .spec-label {
            font-weight: 600;
            color: var(--light);
        }

        .spec-value {
            color: var(--text-light);
        }

        /* Related Products */
        .related-products {
            margin-top: 4rem;
            padding: 4rem 2rem;
            background: var(--dark-lighter);
            margin-left: -2rem;
            margin-right: -2rem;
        }

        .related-products-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .section-title {
            font-size: 2rem;
            margin-bottom: 2rem;
            font-weight: 700;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
        }

        .product-card {
            background: var(--dark);
            border-radius: var(--border-radius);
            overflow: hidden;
            transition: var(--transition);
            border: 1px solid rgba(255, 255, 255, 0.05);
            cursor: pointer;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .product-image {
            height: 200px;
            background: var(--dark-lighter);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
        }

        .product-image img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .product-info {
            padding: 1.5rem;
        }

        .product-card-brand {
            color: var(--text-light);
            font-size: 0.875rem;
            margin-bottom: 0.5rem;
            text-transform: uppercase;
        }

        .product-card-title {
            font-size: 1.1rem;
            margin-bottom: 0.75rem;
            font-weight: 600;
        }

        .product-card-price {
            font-size: 1.3rem;
            color: var(--primary);
            font-weight: 700;
        }

        /* Footer */
        .footer {
            background: var(--dark);
            padding: var(--spacing-lg) 2rem;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin-top: 4rem;
        }

        .footer-container {
            max-width: 1400px;
            margin: 0 auto;
            text-align: center;
            color: var(--text-light);
        }

        /* Responsive Design */
        @media (max-width: 968px) {
            .product-container {
                grid-template-columns: 1fr;
                gap: 2rem;
            }

            .product-gallery {
                position: static;
            }

            .product-title {
                font-size: 2rem;
            }

            .price-main {
                font-size: 2rem;
            }

            .thumbnail-gallery {
                grid-template-columns: repeat(3, 1fr);
            }

            .spec-row {
                grid-template-columns: 1fr;
                gap: 0.5rem;
            }

            .product-grid {
                grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            }

            .nav-menu {
                display: none;
            }
        }

        @media (max-width: 640px) {
            .product-title {
                font-size: 1.5rem;
            }

            .main-image {
                min-height: 300px;
            }

            .thumbnail-gallery {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
